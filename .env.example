# Dane do kontenera Postgres (używane przy pierwszym starcie bazy)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app_db

# Connection string używany przez aplikację
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/app_db
